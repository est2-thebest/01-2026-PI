# .env.example
#
# Este arquivo documenta as variáveis de ambiente do projeto.
# Não contém valores reais de produção.
#
# Como usar:
#   Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env

# Backend (Spring Boot) 

# Porta do servidor (padrão: 8080)
SERVER_PORT=8080

# Banco de dados H2 em memória (ambiente de desenvolvimento)
# Não alterar — configurado via application.properties (RFC-001)
# SPRING_DATASOURCE_URL=jdbc:h2:mem:sosrotadb

# Segredo JWT — usado para assinar tokens de autenticação
# Em produção: substituir por uma chave de pelo menos 256 bits
JWT_SECRET=minha-chave-super-secreta-com-pelo-menos-256-bits

# Frontend (Angular)

# URL base da API consumida pelo Angular
# Configurada em frontend/src/environments/environment.ts
# Não requer variável de ambiente — alterar diretamente no arquivo
ANGULAR_API_URL=http://localhost:8080/api
